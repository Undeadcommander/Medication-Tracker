{
  "name": "medication-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Medication tracker with schedules, push reminders and encrypted export",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Undeadcommander/Medication-Tracker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Undeadcommander/Medication-Tracker/issues"
  },
  "homepage": "https://github.com/Undeadcommander/Medication-Tracker#readme",
  "dependencies": {
    "express": "^5.3.0",
    "firebase": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@firebase/util": false,
    "protobufjs": false
  }
}
