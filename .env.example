# The Firebase web config lives in src/firebase-config.json (committed; it's public by design).
# These optional variables override it, e.g. to point a local build at a test project.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Reminder server address for the web app. Leave unset when the server serves the app (npm run dev / npm start).
# Set to a full URL (https://host/api) when it's hosted separately, or "none" for a static-only build.
# VITE_API_BASE=

# ----- Reminder server (server/index.ts) -----
PORT=8787
# Contact for VAPID (mailto: or https: URL). Use a real address; Apple can reject placeholders.
VAPID_SUBJECT=mailto:admin@example.com
# Front-end origins allowed to call the server when the app is hosted elsewhere (comma-separated).
# ALLOWED_ORIGINS=https://undeadcommander.github.io
