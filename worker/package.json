{
  "name": "dosely-push-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Dosely reminder server (Web Push) for Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "gen-vapid": "node scripts/gen-vapid.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --config vitest.node.config.ts && vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@cloudflare/workers-types": "5.20261112.1",
    "@types/node": "26.6.7",
    "http_ece": "1.2.1",
    "jose": "6.2.13",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
